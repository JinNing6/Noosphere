{
  "mcpServers": {
    "noosphere": {
      "command": "uvx",
      "args": [
        "noosphere-mcp"
      ],
      "env": {
        "NOOSPHERE_REPO": "JinNing6/Noosphere",
        "NOOSPHERE_MCP_PROFILE": "skills"
      },
      "env_vars": [
        "GITHUB_TOKEN"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 120
    }
  }
}
